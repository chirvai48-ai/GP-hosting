# Copy to .env and fill in. Mirrors the vars rendered by
# .github/workflows/deploy.yml, so anything added here needs a GitHub secret too.

NODE_ENV=development
PORT=4000

# ---- database (MariaDB) ----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# ---- auth ----
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ---- Cloudflare R2 ----
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_ACCOUNT_ID=

# ---- Google Chat notifications ----
# One incoming-webhook URL per space. Create each in the Chat space:
#   Space name ▾ → Apps & integrations → Webhooks → Add webhook → copy URL.
# The URL *is* the credential — treat it as a secret. Any var left blank makes
# that category a logged no-op rather than an error, so partial setup is fine.
GOOGLE_CHAT_WEBHOOK_APPLICATIONS=
GOOGLE_CHAT_WEBHOOK_INQUIRIES=
GOOGLE_CHAT_WEBHOOK_DIGEST=
# Fallback used for any category above that is left blank — set this alone to
# route everything into a single space.
GOOGLE_CHAT_WEBHOOK_URL=
# Public origin of the admin dashboard, used to build card deep links.
ADMIN_BASE_URL=http://localhost:3000
# Set to "false" to silence all Chat notifications (useful in dev).
NOTIFY_ENABLED=true
